+# --- troubleshooting -----------------------------------------------------------
+@app.get("/api/diag/ping")
+def diag_ping():
+    """Can the API reach a host? Handy when debugging networking: /api/diag/ping?host=example.com"""
+    host = request.args.get("host", "localhost")
+    out = subprocess.run(f"ping -c 1 -W 1 {host}", shell=True, capture_output=True, text=True, timeout=5)
+    return jsonify(host=host, reachable=out.returncode == 0, output=(out.stdout + out.stderr)[-500:])
