# local/up.sh staging  ->  http://localhost:8083   (orange badge, v3 emerald theme, "Release security" card)
PODPOLL_ENV=staging
FRONTEND_PORT=8083
API_VERSION=3.0
FRONTEND_VERSION=3.0
