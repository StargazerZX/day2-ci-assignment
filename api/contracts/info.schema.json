{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "info.schema.json",
  "title": "PodPoll info",
  "type": "object",
  "required": [
    "pod",
    "namespace",
    "node",
    "version",
    "env",
    "platform",
    "git_sha",
    "ci_system",
    "reset_protected",
    "chaos"
  ],
  "properties": {
    "pod": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "env": {
      "type": "string"
    },
    "platform": {
      "enum": [
        "kubernetes",
        "ecs",
        "docker"
      ]
    },
    "git_sha": {
      "type": "string"
    },
    "ci_system": {
      "type": "string"
    },
    "reset_protected": {
      "type": "boolean"
    },
    "chaos": {
      "type": "object",
      "required": [
        "ready_fail",
        "start_delay_seconds",
        "error_rate"
      ],
      "properties": {
        "ready_fail": {
          "type": "boolean"
        },
        "start_delay_seconds": {
          "type": "number"
        },
        "error_rate": {
          "type": "number"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
